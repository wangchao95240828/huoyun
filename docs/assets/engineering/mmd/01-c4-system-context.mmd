%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial, Microsoft YaHei, sans-serif", "primaryColor": "#e8f3ff", "primaryBorderColor": "#2f6feb", "primaryTextColor": "#172033", "lineColor": "#6b7280", "secondaryColor": "#f8fafc", "tertiaryColor": "#fff7ed"}}}%%
flowchart LR
  classDef person fill:#f8fafc,stroke:#64748b,color:#111827,stroke-width:1px
  classDef system fill:#e8f3ff,stroke:#2f6feb,color:#0f172a,stroke-width:2px
  classDef external fill:#fff7ed,stroke:#f59e0b,color:#111827,stroke-width:1px
  classDef data fill:#ecfdf5,stroke:#16a34a,color:#052e16,stroke-width:1px

  finance["财务人员<br/>账单 / 核销 / 对账"]:::person
  ops["操作人员<br/>订单 / 运单 / 异常"]:::person
  warehouse["仓库人员<br/>入库 / 出库 / 装箱"]:::person
  admin["系统管理员<br/>账号 / 权限 / 配置"]:::person
  customer["客户 / 客户 API<br/>下单 / 查轨迹 / 查账单"]:::person

  platform["新航线统一平台<br/>新业务事实来源<br/>统一权限、流程、财务和账本"]:::system

  acc["ACC 旧系统<br/>源码 / 旧 MySQL / 旧计费口径"]:::external
  xqt["新智慧 TMS/AOS<br/>页面 / 只读请求 / 表单字段"]:::external
  carrier["物流商 / 渠道接口<br/>取号 / 面单 / 轨迹"]:::external
  bank["银行 / 支付渠道<br/>收付款流水"]:::external
  notify["短信 / 邮件 / 企业通知"]:::external
  objectStorage["对象存储<br/>面单 / 导入文件 / 附件"]:::data

  finance -->|"财务查询、审核、核销"| platform
  ops -->|"订单、运单、异常处理"| platform
  warehouse -->|"仓库作业"| platform
  admin -->|"租户、用户、权限、配置"| platform
  customer -->|"客户门户 / API"| platform

  platform -. "源码反推 / 只读对照" .-> acc
  platform -. "页面复刻 / 只读对照" .-> xqt
  platform -->|"取号、轨迹、标签"| carrier
  platform -->|"对账、流水导入"| bank
  platform -->|"业务通知"| notify
  platform -->|"文件读写"| objectStorage
