# FedEx 集成 — 把这文件复制为 .env 并填实际值

# xqt-saas 后端地址
XQT_BASE_URL=http://127.0.0.1:18103

# 服务到服务 token —— 与后端 application.yml 的 xqt.tracking.ingest-token 保持一致
# 生产建议用随机长字符串，如: openssl rand -hex 32
XQT_INGEST_TOKEN=change-me-to-random-32-bytes

# (可选) admin Bearer token 让 runner.py 拉待跟踪号
# 生产建议用专门的 service-account 而非 admin，权限收敛到只读 shipments
XQT_ADMIN_TOKEN=

# 爬虫 HTTP 服务地址 (dev-jiang 分支的 python/fedex/main.py uv run)
# 默认 :8080；改端口需启动时 uv run main.py --port=NNNN
FEDEX_CRAWLER_URL=http://127.0.0.1:8080
FEDEX_TIMEOUT=60
