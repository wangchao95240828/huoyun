APP_ENV=server-db
API_PORT=18103

# Use scripts/server-db-tunnel.sh first. The tunnel maps local 15433 to PostgreSQL on the configured server.
XQT_DB_SERVER_HOST=<server-ip>
XQT_DB_SERVER_USER=root
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:15433/xqt_saas
SPRING_DATASOURCE_USERNAME=xqt
SPRING_DATASOURCE_PASSWORD=<read-from-/root/xqt_saas_db.env-or-/tmp/xqt_saas_db.env>

REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=<set-a-real-secret>
TENANT_DEFAULT_CODE=xqt
