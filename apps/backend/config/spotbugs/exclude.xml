<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
        <Class name="~com\.xqt\.saas\..*(Controller|Service|Repository|RequestContext|JsonSupport|BearerAuthFilter|TokenService|CustomerApiAuthFilter|RateEngine)"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="~com\.xqt\.saas\.customerapi\.(CustomerApiRequests.*|CustomerApiResponses.*|CachedBodyHttpServletRequest|CustomerApiAuthFilter)"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="~com\.xqt\.saas\.rates\.RateQuoteResponse.*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Lombok @With on records generates == comparisons as a same-reference fast-path; not a real bug -->
    <Match>
        <Class name="~com\.xqt\.saas\.finance\.dto\.request\..*"/>
        <Bug pattern="ES_COMPARING_PARAMETER_STRING_WITH_EQ,RC_REF_COMPARISON"/>
    </Match>
</FindBugsFilter>
